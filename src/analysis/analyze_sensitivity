function sa_tables(R, ef_idx, KPI, cfg)
    % Table 2: error-free vs. baseline
    f = fopen(fullfile(cfg.figdir, 'table_baseline_vs_errorfree.csv'), 'w');
    fprintf(f, 'kpi,error_free,baseline_mean,baseline_ci95,n_reps\n');
    for k = 1:numel(KPI)
        s = sa_stats(sa_vals(R, 'baseline', KPI(k).name)); ef = NaN;
        if ~isempty(ef_idx), ef = R(ef_idx).(KPI(k).name); end
        fprintf(f, '"%s",%.6g,%.6g,%.6g,%d\n', strrep(KPI(k).label, '"', ''''), ef, s.mean, s.ci, s.n);
    end
    fclose(f);
    % all settings (appendix)
    isrun = find(strcmp({R.kind}, 'run')); tags = unique({R(isrun).tag}, 'stable');
    f = fopen(fullfile(cfg.figdir, 'table_all_settings.csv'), 'w');
    fprintf(f, 'tag,setting,n_reps');
    for k = 1:numel(KPI), fprintf(f, ',%s_mean,%s_ci95', KPI(k).name, KPI(k).name); end
    fprintf(f, '\n');
    for t = 1:numel(tags)
        r = R(find(strcmp({R.tag}, tags{t}), 1));
        [v, reps] = sa_vals(R, tags{t}, 'sep_episodes'); %#ok<ASGLU>
        fprintf(f, '%s,"%s",%d', tags{t}, sa_setting_label(r), numel(reps));
        for k = 1:numel(KPI)
            s = sa_stats(sa_vals(R, tags{t}, KPI(k).name)); fprintf(f, ',%.6g,%.6g', s.mean, s.ci);
        end
        fprintf(f, '\n');
    end
    fclose(f);
end

function sa_print_summary(R, ef_idx, KPI)
    fprintf('\n=== Baseline vs. error-free ===\n');
    for k = 1:numel(KPI)
        s = sa_stats(sa_vals(R, 'baseline', KPI(k).name)); ef = NaN;
        if ~isempty(ef_idx), ef = R(ef_idx).(KPI(k).name); end
        fprintf('%-45s error-free %10.4g | baseline %10.4g +/- %.3g (n=%d)\n', KPI(k).label, ef, s.mean, s.ci, s.n);
    end
    fprintf('\nIf "mean aircraft in area" or "share of steps with max. sectors" is clearly higher with errors,\n');
    fprintf('the errors make aircraft accumulate (see diag_traffic_over_time, diag_final_state).\n\n');
end
