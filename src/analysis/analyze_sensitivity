function sa_diag_traffic(R, ef_idx, cfg)
    ib = find(strcmp({R.tag}, 'baseline') & strcmp({R.kind}, 'run'));
    if isempty(ib), return; end
    N = min(arrayfun(@(i) numel(R(i).ac), ib)); dt = R(ib(1)).dt; x = (0:N-1) * dt / 60;
    fields = {'ac', 'nsec', 'sep'}; ylab = {'Aircraft in area', 'Open sectors', 'Cumulative aircraft-minutes in infringement'};
    fig = sa_newfig(cfg, 900, 850);
    for f = 1:3
        subplot(3, 1, f); hold on;
        A = zeros(numel(ib), N);
        for k = 1:numel(ib)
            v = R(ib(k)).(fields{f})(1:N); if f == 3, v = cumsum(v) * dt / 60; end
            A(k, :) = v;
        end
        fill([x fliplr(x)], [min(A, [], 1) fliplr(max(A, [], 1))], [0.95 0.75 0.7], 'EdgeColor', 'none');
        plot(x, mean(A, 1), 'Color', [0.8 0.2 0.2], 'LineWidth', 1.8);
        leg = {'range of replications', 'with errors (mean)'};
        if ~isempty(ef_idx)
            v = R(ef_idx).(fields{f})(1:N); if f == 3, v = cumsum(v) * dt / 60; end
            plot(x, v, 'Color', [0.1 0.4 0.7], 'LineWidth', 1.8); leg{end+1} = 'error-free'; %#ok<AGROW>
        end
        ylabel(ylab{f}); xlim([0 x(end)]); grid on; if f == 1, legend(leg, 'Location', 'best'); end
        if f == 3, xlabel('Simulation time (min)'); end
        hold off;
    end
    sa_save(fig, 'diag_traffic_over_time', cfg);
end

function sa_diag_max_sectors(R, ef_idx, cfg)
    isrun = find(strcmp({R.kind}, 'run'));
    tags = unique({R(isrun).tag}, 'stable'); n = numel(tags);
    v = zeros(1, n); c = v; lab = cell(1, n);
    for t = 1:n
        s = sa_stats(sa_vals(R, tags{t}, 'maxcfg_share')); v(t) = s.mean * 100; c(t) = ifelse_nan(s.ci) * 100;
        lab{t} = sa_setting_label(R(find(strcmp({R.tag}, tags{t}), 1)));
    end
    fig = sa_newfig(cfg, 900, 120 + 22 * n); hold on;
    barh(1:n, v, 0.7, 'FaceColor', [0.85 0.45 0.25], 'EdgeColor', 'none');
    for t = 1:n, plot(v(t) + [-1 1] * c(t), [t t], 'k-'); end
    if ~isempty(ef_idx), plot(R(ef_idx).maxcfg_share * [100 100], [0 n + 1], 'b--', 'LineWidth', 1.5); end
    set(gca, 'YDir', 'reverse', 'YTick', 1:n, 'YTickLabel', strrep(lab, '_', '\_'), 'YLim', [0 n + 1]);
    xlabel('Share of steps with the maximum number of sectors open (%)  [upper bound of SV fallback]');
    title('Dashed: error-free run'); grid on; hold off;
    sa_save(fig, 'diag_max_sectors', cfg);
end

function sa_diag_final_state(R, ef_idx, cfg)
    ib = find(strcmp({R.tag}, 'baseline') & strcmp({R.kind}, 'run'));
    FLb = [R(ib).fl];
    if isempty(FLb) || isempty(ef_idx) || isempty(R(ef_idx).fl)
        fprintf('diag_final_state: no aircraft state (D) saved, skipped.\n'); return;
    end
    FLe = R(ef_idx).fl; edges = 0:10:700;
    ne = histc(FLe, edges) / numel(FLe); nb = histc(FLb, edges) / numel(FLb);
    fig = sa_newfig(cfg, 800, 450); hold on;
    stairs(edges, ne, 'Color', [0.1 0.4 0.7], 'LineWidth', 2);
    stairs(edges, nb, 'Color', [0.8 0.2 0.2], 'LineWidth', 2);
    yl = max([ne nb]) * 1.1; plot([120 120], [0 yl], 'k--'); plot([400 400], [0 yl], 'k--');
    xlabel('Flight level of aircraft at the end of the run'); ylabel('Relative frequency');
    legend({sprintf('error-free (%.1f%% outside 120-400)', 100 * R(ef_idx).fl_out), ...
            sprintf('with errors (%.1f%% outside)', 100 * mean([R(ib).fl_out]))}, 'Location', 'northeast');
    title('Dashed: range of flight levels that generateRequests allows'); grid on; hold off;
    sa_save(fig, 'diag_final_state', cfg);
end

function sa_diag_overview(R, KPI, cfg)
    ord = sa_param_order(); isrun = find(strcmp({R.kind}, 'run'));
    tags = {}; keys = [];
    for i = 1:numel(ord)
        t = sa_tags(R, ord{i});
        if isempty(t), continue; end
        vals = zeros(1, numel(t));
        for k = 1:numel(t)
            r = R(find(strcmp({R.tag}, t{k}), 1));
            switch ord{i}
                case 'tau_mem+W_crit', vals(k) = r.p.tau_mem;
                case 'A_u+tau_u',      vals(k) = r.p.A_u * 1000 + r.p.tau_u;
                otherwise,             vals(k) = r.p.(ord{i});
            end
        end
        [~, o] = sort(vals); tags = [tags, t(o)]; %#ok<AGROW>
    end
    n = numel(tags); nk = numel(KPI); M = NaN(n, nk); lab = cell(n, 1);
    for t = 1:n
        lab{t} = sa_setting_label(R(find(strcmp({R.tag}, tags{t}), 1)));
        for k = 1:nk
            [d, ~, b] = sa_paired(R, tags{t}, 'baseline', KPI(k).name);
            if ~isempty(b) && mean(b) > 0 && ~all(isnan(d)), M(t, k) = mean(d) / mean(b) * 100; end
        end
    end
    fig = sa_newfig(cfg, 1150, 140 + 22 * n);
    lim = 100; Mc = max(min(M, lim), -lim);
    imagesc(Mc, [-lim lim]); colormap(sa_diverging(64)); colorbar;
    set(gca, 'YTick', 1:n, 'YTickLabel', strrep(lab, '_', '\_'), 'XTick', 1:nk, 'XTickLabel', {});
    for k = 1:nk
        text(k, n + 0.9, KPI(k).label, 'Rotation', -30, 'HorizontalAlignment', 'left', 'FontSize', 8);
    end
    for t = 1:n
        for k = 1:nk
            if ~isnan(M(t, k)), text(k, t, sprintf('%+.0f', M(t, k)), 'HorizontalAlignment', 'center', 'FontSize', 8); end
        end
    end
    title('Change vs. baseline (%, paired mean over replications; color clipped at \pm100%)');
    set(gca, 'Position', [0.22 0.18 0.62 0.74]);
    sa_save(fig, 'diag_overview_heatmap', cfg);
end

