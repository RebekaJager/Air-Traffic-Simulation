%% Sector Configuration Builder (Synthetic Open-Source Version)
% Procedurally generates realistic, contiguous ATC sector configurations 
% with randomized sustained and peak capacity limits for demonstration.
% Saves output to data/sector_configurations.mat

clear; clc;
rng(42); % Fixed seed for reproducible synthetic generation

Configurations = struct('ConfigID', {}, 'Description', {}, 'NumSectors', {}, 'OperationalSectors', {});

% Define valid lateral region groupings (contiguous regions)
lateral_schemes = {
    {{'W', 'S', 'E', 'N'}}, ...             % 1 lateral block (Bandbox)
    {{'W', 'S'}, {'E', 'N'}}, ...           % 2 lateral blocks
    {{'W'}, {'S'}, {'E', 'N'}}, ...         % 3 lateral blocks
    {{'W'}, {'S'}, {'E'}, {'N'}}            % 4 lateral blocks
    };

% Blueprints: [lateral_scheme_index, vertical_splits_per_block]
blueprints = [
    1, 1;  % 1 sector
    2, 1;  % 2 sectors (lateral)
    1, 2;  % 2 sectors (vertical variant A)
    1, 2;  % 2 sectors (vertical variant B)
    2, 2;  % 4 sectors (variant A)
    2, 2;  % 4 sectors (variant B)
    4, 1;  % 4 sectors (lateral only)
    3, 2;  % 6 sectors
    2, 3;  % 6 sectors (3 vertical layers)
    4, 2;  % 8 sectors (variant A)
    4, 2;  % 8 sectors (variant B)
    3, 3;  % 9 sectors
    4, 3;  % 12 sectors
    4, 4   % 16 sectors
    ];

num_configs = size(blueprints, 1);

for c = 1:num_configs
    scheme_idx = blueprints(c, 1);
    v_splits   = blueprints(c, 2);
    lat_groups = lateral_schemes{scheme_idx};

    op_sectors = struct('SectorName', {}, 'Capacity', {}, 'Capacity_peak', {}, 'ElementaryIDs', {});
    sec_count = 0;

    for g = 1:length(lat_groups)
        regs = lat_groups{g};
        reg_name = [regs{:}];

        % Generate random contiguous vertical slices across layers 0..9
        if v_splits == 1
            layer_bounds = [0, 10];
        else
            % Pick random internal split points between layer 1 and 9
            split_pts = sort(randperm(8, v_splits - 1));
            layer_bounds = [0, split_pts, 10];
        end

        for v = 1:v_splits
            fl_start = layer_bounds(v);
            fl_end   = layer_bounds(v+1) - 1;

            % Collect elementary sector IDs for this 3D block
            elem_ids = {};
            for r = 1:length(regs)
                for fl = fl_start:fl_end
                    elem_ids{end+1} = sprintf('LHCC%s%d', regs{r}, fl); %#ok<SAGROW>
                end
            end

            % Generate realistic random capacities
            base_cap = randi([8, 15]);
            peak_cap = base_cap + randi([2, 6]);

            sec_count = sec_count + 1;
            op_sectors(sec_count).SectorName    = sprintf('SYN_%s_%d_%d', reg_name, fl_start, fl_end);
            op_sectors(sec_count).Capacity      = base_cap;
            op_sectors(sec_count).Capacity_peak = peak_cap;
            op_sectors(sec_count).ElementaryIDs = elem_ids;
        end
    end

    Configurations(c).ConfigID           = c;
    Configurations(c).Description        = sprintf('Synthetic Config %d (%d Sectors)', c, sec_count);
    Configurations(c).NumSectors         = sec_count;
    Configurations(c).OperationalSectors = op_sectors;
end

projectRoot = getenv('PROJECT_ROOT');
if isempty(projectRoot)
    projectRoot = pwd;
end

save(fullfile(projectRoot, 'data', 'sector_configurations.mat'), 'Configurations');
fprintf('Successfully generated and saved %d synthetic configurations.\n', length(Configurations));
