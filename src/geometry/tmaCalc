function [lat, lon] = parseRing(s)
% PARSERING - 'DDMMSSN DDDMMSSE - DDMMSSN DDDMMSSE - [lat lon] - ...' to vectors.
tok = strtrim(strsplit(s, ' - '));
n = numel(tok);
lat = zeros(n, 1);
lon = zeros(n, 1);
for i = 1:n
    if startsWith(tok{i}, '[')
        v = sscanf(tok{i}, '[%f %f]');      % fictitious vertex, decimal degrees
        lat(i) = v(1);
        lon(i) = v(2);
    else
        [lat(i), lon(i)] = parsePoint(tok{i});
    end
end
% drop the closing vertex (equal to the first one)
if n > 1 && lat(end) == lat(1) && lon(end) == lon(1)
    lat(end) = [];
    lon(end) = [];
end
end

function [lat, lon] = parsePoint(s)
% PARSEPOINT - 'DDMMSSN DDDMMSSE' (AIP format) to decimal degrees.
t = regexp(strtrim(s), '^(\d{2})(\d{2})(\d{2}(?:\.\d+)?)N\s+(\d{3})(\d{2})(\d{2}(?:\.\d+)?)E$', 'tokens', 'once');
if isempty(t)
    error('tmaCalc:badCoordinate', 'Cannot parse coordinate "%s".', s);
end
v = str2double(t);
lat = v(1) + v(2) / 60 + v(3) / 3600;
lon = v(4) + v(5) / 60 + v(6) / 3600;
end
